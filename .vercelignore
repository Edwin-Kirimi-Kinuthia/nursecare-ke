node_modules
.git
.next
**/.next
.turbo
**/.turbo

# Standalone app dependencies, installers and test artifacts are not web sources.
**/node_modules
**/dist
**/build
**/.expo
**/test-results
**/playwright-report
**/coverage

# Production configuration comes from Vercel environment variables.
.env
**/.env
**/.env.*
