{
  "name": "carebora-desktop",
  "productName": "Care Bora",
  "version": "1.0.1",
  "description": "Care Bora consultations and service notifications for desktop",
  "private": true,
  "author": "Carebora",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:windows": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ke.co.carebora.desktop",
    "artifactName": "CareBora-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Care Bora uses your camera during video consultations.",
        "NSMicrophoneUsageDescription": "Care Bora uses your microphone during video consultations."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "category": "Medical",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Carebora <customercare@carebora.co.ke>"
    }
  },
  "homepage": "https://app.carebora.co.ke",
  "engines": {
    "node": ">=22.13"
  }
}
