# ─────────────────────────────────────────────────────────────
# CareBora — environment variables
# Copy to .env (root) and apps/web/.env.local as needed.
# NEVER commit real secrets. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Database
# Local dev: the Docker Postgres from docker-compose.yml (just `docker compose up -d`).
DATABASE_URL="postgresql://carebora:carebora@localhost:5432/carebora?schema=public"
# Production: a Neon Postgres pooled connection string (https://neon.tech), e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/carebora?sslmode=require

# Auth — JWT signing secret (generate: openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="900"          # seconds (15 min)
JWT_REFRESH_TTL="2592000"     # seconds (30 days)

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ── The integrations below are wired in later milestones (M3–M6). ──
# ── Add them when you reach those milestones. ──

# LiveKit — video consultations (M3) — https://livekit.io
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# M-Pesa Daraja (M4) — https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"           # sandbox | production
MPESA_CALLBACK_URL=""

# Africa's Talking — SMS / OTP (M1) — https://africastalking.com
AT_API_KEY=""
AT_USERNAME="sandbox"

# Resend — transactional email (M1+) — https://resend.com
RESEND_API_KEY=""

# Vercel Blob — file storage (M1+ KYC docs)
BLOB_READ_WRITE_TOKEN=""
