# ─────────────────────────────────────────────────────────────
# CareBora — environment variables
# Copy to .env (root) and apps/web/.env.local as needed.
# NEVER commit real secrets. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Database
# Local dev: the Docker Postgres from docker-compose.yml (just `docker compose up -d`).
DATABASE_URL="postgresql://carebora:carebora@localhost:5432/carebora?schema=public"
# Production: a Neon Postgres pooled connection string (https://neon.tech), e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/carebora?sslmode=require

# Auth — JWT signing secret (generate: openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="900"          # seconds (15 min)
JWT_REFRESH_TTL="2592000"     # seconds (30 days)

# App URLs
# NEXT_PUBLIC_APP_URL must be the real public origin in production — it drives
# every canonical URL, the sitemap, robots.txt and the JSON-LD. Pointing it at
# the wrong host tells search engines the content belongs somewhere else, which
# actively suppresses ranking rather than merely failing to help.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# SEO — paste the token from Google Search Console (Settings → Ownership
# verification → HTML tag) to verify the domain and get indexing reports.
# Optional; the meta tag is only emitted when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── The integrations below are only needed once you use the feature that ──
# ── depends on them (video consults, payments, SMS, email, file uploads). ──

# LiveKit — video consultations (M3) — https://livekit.io
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Payments — which gateway family handles checkout. Switching between these is
# an env-only change; no code edits are needed.
#   mpesa_daraja — Safaricom Daraja STK push for every subject. THE DEFAULT.
#   jenga        — Jenga API (Equity). Orders use the hosted PGW checkout; every
#                  other subject (appointments, home visits) uses STK push.
#                  Kept as a fallback if Daraja go-live stalls.
#   till         — manual "Buy Goods" Till, admin-verified. No gateway creds at
#                  all — useful for demos and as an emergency stopgap.
PAYMENTS_MODE="mpesa_daraja"
PLATFORM_FEE_PERCENT="10"       # platform commission %, frozen onto each payment at creation

NEXT_PUBLIC_PAYMENTS_MODE="mpesa_daraja"   # mirror of PAYMENTS_MODE for the client
NEXT_PUBLIC_MPESA_TILL_NUMBER="3396662"    # only shown in till mode
NEXT_PUBLIC_MPESA_TILL_NAME="Edwin Kinuthia"

# ── M-Pesa Daraja (primary) — https://developer.safaricom.co.ke ──
# Sandbox: create an app on the Daraja portal and copy its Consumer Key/Secret.
#
# The portal shows "N/A" for Shortcode and Passkey on a sandbox app — they are
# NOT issued per app. Every sandbox app shares the same published test pair,
# already filled in below. STK push fails without them, so don't leave them blank.
# Only the sandbox test MSISDN 254708374149 will accept a push; any other number
# is rejected, and no money moves.
#
# Going live is ONLY these lines — set MPESA_ENV=production, then swap in the
# Consumer Key/Secret from your production app plus the Shortcode and Passkey
# Safaricom issues for your own paybill/till. Nothing else changes.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"      # sandbox test shortcode; your own paybill/till in production
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"  # public sandbox passkey
MPESA_ENV="sandbox"           # sandbox | production
# Must be a public HTTPS URL Safaricom can reach — use ngrok while developing.
MPESA_CALLBACK_URL=""         # e.g. https://your-app.example/api/v1/payments/mpesa/callback

# ── Jenga API (Equity/Finserve) — fallback — https://developer.jengahq.io ──
# Only needed if PAYMENTS_MODE=jenga. Create a merchant account + API key,
# generate an RSA keypair for request signing, and register your callback URLs.
JENGA_ENV="uat"                 # uat | production
JENGA_API_KEY=""
JENGA_MERCHANT_CODE=""
JENGA_CONSUMER_SECRET=""
JENGA_PRIVATE_KEY_B64=""        # base64 of your RSA private key PEM (keeps newlines intact in env)
JENGA_CALLBACK_URL=""           # e.g. https://your-app.example/api/v1/payments/jenga
JENGA_PGW_TOKEN=""              # hosted-checkout token from the Jenga merchant portal

# Africa's Talking — SMS / OTP (M1) — https://africastalking.com
AT_API_KEY=""
AT_USERNAME="sandbox"

# Resend — transactional email (M1+) — https://resend.com
RESEND_API_KEY=""

# Vercel Blob — file storage (M1+ KYC docs)
BLOB_READ_WRITE_TOKEN=""

# Social login — "Continue with Google/Facebook" on /login. Both need the
# callback URL registered in their respective console:
#   {NEXT_PUBLIC_APP_URL}/api/v1/auth/oauth/<provider>/callback
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Meta for Developers → create an app → add the Facebook Login product.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
