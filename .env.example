# ─────────────────────────────────────────────────────────────
# CareBora — environment variables
# Copy to .env (root) and apps/web/.env.local as needed.
# NEVER commit real secrets. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Database
# Local dev: the Docker Postgres from docker-compose.yml (just `docker compose up -d`).
DATABASE_URL="postgresql://carebora:carebora@localhost:5432/carebora?schema=public"
# Production: a Neon Postgres pooled connection string (https://neon.tech), e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/carebora?sslmode=require

# Auth — JWT signing secret (generate: openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="900"          # seconds (15 min)
JWT_REFRESH_TTL="2592000"     # seconds (30 days)

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ── The integrations below are only needed once you use the feature that ──
# ── depends on them (video consults, payments, SMS, email, file uploads). ──

# LiveKit — video consultations (M3) — https://livekit.io
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Payments — which gateway family handles checkout.
#   jenga        — Jenga API. Orders use the hosted PGW checkout; every other
#                  subject (appointments, home visits) uses server-to-server STK push.
#   till         — manual "Buy Goods" Till, admin-verified. No gateway creds needed.
#   mpesa_daraja — legacy direct Safaricom Daraja STK push (kept for environments
#                  without Jenga credentials yet).
PAYMENTS_MODE="mpesa_daraja"
PLATFORM_FEE_PERCENT="10"       # platform commission %, frozen onto each payment at creation

NEXT_PUBLIC_PAYMENTS_MODE="mpesa_daraja"   # mirror of PAYMENTS_MODE for the client
NEXT_PUBLIC_MPESA_TILL_NUMBER="3396662"    # only shown in till mode
NEXT_PUBLIC_MPESA_TILL_NAME="Edwin Kinuthia"

# Jenga API (Equity/Finserve) — https://developer.jengahq.io
# Create a merchant account + API key at developer.jengahq.io, generate an RSA
# keypair for request signing, and register your callback URLs.
JENGA_ENV="uat"                 # uat | production
JENGA_API_KEY=""
JENGA_MERCHANT_CODE=""
JENGA_CONSUMER_SECRET=""
JENGA_PRIVATE_KEY_B64=""        # base64 of your RSA private key PEM (keeps newlines intact in env)
JENGA_CALLBACK_URL=""           # e.g. https://your-app.example/api/v1/payments/jenga
JENGA_PGW_TOKEN=""              # hosted-checkout token from the Jenga merchant portal

# M-Pesa Daraja (legacy) — https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"           # sandbox | production
MPESA_CALLBACK_URL=""

# Africa's Talking — SMS / OTP (M1) — https://africastalking.com
AT_API_KEY=""
AT_USERNAME="sandbox"

# Resend — transactional email (M1+) — https://resend.com
RESEND_API_KEY=""

# Vercel Blob — file storage (M1+ KYC docs)
BLOB_READ_WRITE_TOKEN=""
